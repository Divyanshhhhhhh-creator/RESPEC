# ReSpec — .gitignore

# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Node
node_modules/
**/node_modules/
package-lock.json.bak

# Python
__pycache__/
*.pyc

# Build outputs
dist/
**/dist/
build/
**/build/
.aws-sam/
samconfig.toml
output/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test & coverage
coverage/
**/coverage/
.vitest/

# Temporary & logs
tmp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/
